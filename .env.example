# ─── frea environment configuration ───
# Copy to .env and fill in. Never commit .env.

# Public base URL of the deployed app — used in emails, verification links and
# Stripe redirects. Get this wrong and every emailed link points at localhost.
# Dev: http://localhost:5173    Prod: https://joinfrea.com
PUBLIC_BASE_URL=http://localhost:5173

PORT=3001

# ─── Admin access ───
# Comma-separated .ac.uk addresses allowed into #/admin. Admin sign-in uses the
# same emailed code as everyone else, so this must be an inbox you can read.
# Leave blank and the admin dashboard is closed to everyone, including you.
ADMIN_EMAILS=

# ─── Email (Resend) ───
# Without these, verification codes go to a throwaway Ethereal test inbox that
# only you can see. Fine for development; real students will never get a code.
#
#   1. Sign up at https://resend.com (free tier covers early traffic)
#   2. Verify your sending domain under Domains — this is the step that stops
#      your codes landing in spam, so don't skip it
#   3. Create an API key, then paste it as SMTP_PASS below
#
# Resend's SMTP settings, which nodemailer uses as-is:
# auto (default) uses real SMTP when configured, else a test inbox.
# Set to 'ethereal' locally: a real provider will not deliver to the arbitrary
# addresses tests generate until your sending domain is verified.
MAIL_TRANSPORT=auto

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
# Must be on a domain you verified with Resend.
MAIL_FROM="frea <hello@joinfrea.com>"

# ─── Stripe ───
# Test keys: https://dashboard.stripe.com/test/apikeys
# Without STRIPE_SECRET_KEY, paid checkout refuses cleanly and freabies keep
# working — so you can launch free-only and switch payments on later.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From: stripe listen --forward-to localhost:3001/api/stripe/webhook
# Webhooks without this are rejected rather than trusted.
STRIPE_WEBHOOK_SECRET=

# frea's cut of each playbook sale, taken out of the mentor's payout — never
# added to the student's price. 0.05 = 5%
FREA_FEE_RATE=0.05
