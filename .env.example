# ─── frea environment configuration ───
# Copy to .env and fill in. Never commit .env.

# Public base URL of the deployed app — used in emails, verification links,
# Stripe redirects, and the URL university sign-in returns students to. Get this
# wrong and every emailed link points at localhost and nobody can register:
# Studid will not send a student back to a host only your container can reach.
# Dev: http://localhost:5173    Prod: https://joinfrea.com
PUBLIC_BASE_URL=http://localhost:5173

PORT=3001

# ─── University sign-in (Studid) ───
# Needs no credentials: the secret protecting each verification is minted per
# attempt and never leaves the server. Set this only to point the flow at a stub
# — test/studid.e2e.mjs does, because the real gateway cannot mint a test
# student on demand. Leave it unset everywhere else.
# STUDID_API_BASE=http://127.0.0.1:4571

# ─── Admin access ───
# Comma-separated .ac.uk addresses allowed into #/admin. Admin sign-in uses the
# same emailed code as everyone else, so this must be an inbox you can read.
# Leave blank and the admin dashboard is closed to everyone, including you.
ADMIN_EMAILS=

# ─── Email (Resend) ───
# Without these, verification codes go to a throwaway Ethereal test inbox that
# only you can see. Fine for development; real students will never get a code.
#
#   1. Sign up at https://resend.com (free tier covers early traffic)
#   2. Verify your sending domain under Domains — this is the step that stops
#      your codes landing in spam, so don't skip it
#   3. Create an API key, then paste it as SMTP_PASS below
#
# Resend's SMTP settings, which nodemailer uses as-is:
# auto (default) uses real SMTP when configured, else a test inbox.
# Set to 'ethereal' locally: a real provider will not deliver to the arbitrary
# addresses tests generate until your sending domain is verified.
MAIL_TRANSPORT=auto

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
# Must be on a domain you verified with Resend.
MAIL_FROM="frea <hello@joinfrea.com>"

# ─── Stripe ───
# Test keys: https://dashboard.stripe.com/test/apikeys
# Without STRIPE_SECRET_KEY, paid checkout refuses cleanly and freabies keep
# working — so you can launch free-only and switch payments on later.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From: stripe listen --forward-to localhost:3001/api/stripe/webhook
# Webhooks without this are rejected rather than trusted.
STRIPE_WEBHOOK_SECRET=

# frea's cut of each playbook sale, taken out of the mentor's payout — never
# added to the student's price. 0.05 = 5%
FREA_FEE_RATE=0.05

# Optional. A SECOND Resend key, created with read access, used only by the
# boot probe and /api/admin/mail-log. The sending key above is restricted to
# sending and answers 401 to every GET, which means the probe cannot tell a
# valid sending-only key from a wrong one, and delivery events cannot be
# queried at all.
#
# Resend offers only two scopes — "Sending access" and "Full access" — so there
# is no read-only key to create. Filling this in means putting a FULL ACCESS
# key in the environment, which can also delete domains, mint API keys, and
# read every message's content and recipients. That is a genuinely bigger blast
# radius than the sending key beside it.
#
# Leave it blank unless something actually needs to query the API. The Resend
# dashboard already shows delivery events by hand, which is enough for the
# occasional "did this student's code arrive?". The only thing lost by leaving
# it unset is that the boot probe reports the sending key as "unverified"
# rather than confirmed.
RESEND_READ_API_KEY=

# ─── Sign in with Microsoft (Entra ID) ───────────────────
# Optional but strongly recommended. Roughly four in five .ac.uk addresses are
# filtered by Microsoft or a gateway in front of it, which is what makes
# emailed codes slow. Signing in through the university's own tenant skips the
# inbox entirely. Leave these blank and the button simply does not appear.
#
# From portal.azure.com -> Microsoft Entra ID -> App registrations -> New:
#   - Supported account types: "Accounts in any organizational directory"
#   - Redirect URI (Web): https://joinfrea.com/api/auth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Only needed if the callback is not <PUBLIC_BASE_URL>/api/auth/microsoft/callback.
MS_REDIRECT_URI=
