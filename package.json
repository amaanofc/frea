{
  "name": "peer-connect",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "node scripts/generate-brand-assets.mjs && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test test/payments.test.mjs test/frontend.test.mjs test/backup.test.mjs test/email.test.mjs",
    "test:api": "node test/api.e2e.mjs",
    "test:unit": "node --test test/payments.test.mjs",
    "test:backup": "node --test test/backup.test.mjs",
    "test:journeys": "node test/journeys.e2e.mjs",
    "seed:resources": "node scripts/seed-resources.mjs",
    "test:regressions": "node test/regressions.e2e.mjs",
    "reset:launch": "node scripts/reset-launch.mjs",
    "test:pitch": "node test/pitch-video.e2e.mjs",
    "test:connect": "node test/connect.e2e.mjs",
    "test:stars": "node test/stars.e2e.mjs",
    "test:verifylink": "node test/verify-link.e2e.mjs",
    "test:all": "npm run test && npm run test:api && npm run test:journeys && npm run test:regressions && npm run test:pitch && npm run test:connect && npm run test:stars && npm run test:verifylink && npm run test:webhooks",
    "stripe": "tools/stripe/stripe.exe",
    "stripe:login": "tools/stripe/stripe.exe login",
    "stripe:listen": "tools/stripe/stripe.exe listen --forward-to localhost:3001/api/stripe/webhook",
    "reset:dev": "node scripts/reset-dev.mjs",
    "assets": "node scripts/generate-brand-assets.mjs",
    "start:local": "npm run build && node server/index.js",
    "test:smoke": "node test/smoke.mjs",
    "railway": "npx --yes @railway/cli",
    "deploy": "npx --yes @railway/cli up",
    "logs": "npx --yes @railway/cli logs",
    "test:webhooks": "node test/webhooks.e2e.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "jsdom": "^29.1.1"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "jszip": "^3.10.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
